PORT=4000
# Use mongodb://localhost:27017/ticketing when running outside Docker
MONGO_URI=mongodb://mongo:27017/ticketing
JWT_SECRET=dev-only-change-me-in-production
JWT_EXPIRES_IN=8h
# Use http://localhost:8000 when running outside Docker
ML_SERVICE_URL=http://ml-service:8000
ML_TIMEOUT_MS=3000
# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:3000
# Seed demo data automatically when the users collection is empty
AUTO_SEED=true
